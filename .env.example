# ===== General Settings =====
DEBUG=False
SECRET_KEY=your_strong_secret_key_here_change_this

# ===== Database (Railway sets this automatically for PostgreSQL) =====
# DATABASE_URL=postgresql://user:password@host:port/dbname
# For local SQLite (leave empty to use SQLite):
# DATABASE_URI=sqlite:///face_recognition.db

# ===== Face Recognition Settings =====
FACE_RECOGNITION_MODEL=simple
FACE_DETECTION_MODEL=opencv
FACE_SIMILARITY_THRESHOLD=0.65
FACE_SIMILARITY_METHOD=hybrid

# ===== Camera Settings (not used on Railway) =====
CAMERA_SOURCE=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# ===== Email Notifications (optional) =====
ENABLE_EMAIL_NOTIFICATIONS=False
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECIPIENT=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ===== Telegram Notifications (optional) =====
ENABLE_TELEGRAM_NOTIFICATIONS=False
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Door Control (Raspberry Pi only) =====
DOOR_RELAY_PIN=17
DOOR_OPEN_DURATION=5.0
